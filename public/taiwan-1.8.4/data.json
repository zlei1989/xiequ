ff7d","commentLastAltered":1454056542,"commentType":"票证"}},"tripContent":"","tripID":"031a6a33-f72f-dd44-8b36-01528c25a077","tripLastAltered":1454050522,"tripMinutes":150,"tripSort":0,"tripSubject":"花莲火车站 - 瑞芳火车站, 台铁, 自强407","tripType":"交通"},"16bcf99f-1e5e-7e84-0bdd-01528c267d57":{"tripComments":[],"tripContent":"","tripID":"16bcf99f-1e5e-7e84-0bdd-01528c267d57","tripLastAltered":1454050543,"tripMinutes":25,"tripSort":1,"tripSubject":"瑞芳火车站","tripType":"观光"},"dbbd6e99-ed40-d60e-cf6a-01528c27e877":{"tripComments":{"d649d088-79ab-0603-d06c-01528c292096":{"commentContent":"九份老街站, 公交, 1062、788、827\n台湾好行自9点起每小时一趟","commentCurrency":"TWD","commentFees":30,"commentID":"d649d088-79ab-0603-d06c-01528c292096","commentLastAltered":1454392382,"commentType":"攻略"}},"tripContent":"","tripID":"dbbd6e99-ed40-d60e-cf6a-01528c27e877","tripLastAltered":1454050372,"tripMinutes":15,"tripSort":2,"tripSubject":"瑞芳火车站 - 九份, 台湾好行","tripType":"交通"},"1f7b81f6-f73e-1899-2895-01528c2af86f":{"tripComments":{"6e5a20b8-dcba-8d16-6ec9-01528c2bb18f":{"commentContent":"地址：新北市瑞芳区汽车路7之5号(九份地区、九份老街口旁), 303雙人小套房\n电话：+886-937053516","commentCurrency":"CNY","commentFees":281,"commentID":"6e5a20b8-dcba-8d16-6ec9-01528c2bb18f","commentLastAltered":1454154127,"commentType":"票证"},"d6dfc539-68a4-d2af-39ea-01528e268936":{"commentContent":"·交通咨询：\n高媽媽民宿位於九份汽車路上，走幾步路就到老街，請參考以下交通方式前來：\n●從台北搭捷運轉公車： \n您乘搭捷運板南線至忠孝興站下車，１號出口出站，出站後往復興南路方向走(轉角是\"NET\"服飾店)即可看到搭公交車車亭(在復興南路上西堤牛排前)，搭乘基隆客運1062號公車往金瓜石、九份的公車(要注意客運上掛的牌子，有的公車只到瑞芳1061號，一定要坐1062號)，途經中崙、台安醫院、監理處、松山火車站…等、車程約1.5小時(車資NT$102元,可刷悠遊卡)，到達九份時請在\"九份老街站\"(舊站名”舊道”)下車，下車後請延著馬路往上走20公尺即可到7-11便利商店(延著馬路往上看即可看到民宿招牌)，到了7-11後再順著馬路往上走20公尺即到達民宿門口。\n\n●在基隆搭基隆客運：\n搭乘往金瓜石班車788號，車程約45分鐘。到達九份時請在\"九份老街站\"(舊站名”舊道”)下車，下車後請延著馬路往上走20公尺即可到7-11便利商店(延著馬路往上看即可看到民宿招牌)，到了7-11後再順著馬路往上走20公尺即到達民宿門口。\n\n● 搭火車：\n搭乘東部幹線往宜蘭、花蓮方向火車在\"瑞芳站下車\"，您搭到瑞芳火車站出站後會經過一個小廣場，廣場對面有一家頂好超市，面對超市延著馬路往左走約120公尺會看到另一個廣場，廣場前就是搭往九份、金瓜石的公交車車亭(1062、788號公車), 從瑞芳到九份車程約10~15分鐘(車資NT$15元,可刷悠遊卡)，請一定要在\"九份老街站\"(舊站名”舊道”)下車，下車後延著馬路往上走20公尺即可看到7-11便利商店(延著馬路往上看即可看到民宿招牌)，到了7-11後再順著馬路往上走20公尺即到民宿門口。\n\n●計程車：\n瑞芳火車站有共乘或者包車可抵達九份，上車前請先談妥價格。請搭乘到\"九份老街口(7-11便利商店)\"下車或直接搭乘到民宿門口，車程約10-15分鐘。\n\n·注意事项：\n．訂房請務必填寫有效証件上的真實姓名(與入台証、護照上姓名相同)，以便核實訂單。\n．為了提供良好的服務，住房當日請於下午6前辦理入住手續(服務員下午19:00下班)，如無法如期到達請來電告知。\n. 九份老街店家约晚上18:00-19:00点陆续打烊，建议不要太晚抵达。\n．入住時間：下午３：００　退房時間：隔天上午１１：００。１１：００～３：００為清潔時間，無對外開放請見諒！\n．九份是個山城，房子都是依山勢而建，我們的房間不大，實際房間大小請訂房前參考各房介紹。另如果您是有大件行李的貴賓，您亦可將行李寄存於瑞芳火車站週邊商店或放置於民宿一樓空間，只帶上貴重物品及簡單衣物至客房。\n.入住前會私信或email告知貴賓來民宿的交通資訊。請勿google地圖找尋本民宿地址，因地圖定位的位置是錯誤的。\n.本民宿客房多為雙人房，因房間空間不大，所以客房均無法加床，您如有小孩同行請訂房前務必告知，以免訂單取消。\n.本民宿謝絕各種寵物入住，請訂房前注意。\n\n·民宿主人说： (请提前一天联系我，告知入住时间，谢谢！)","commentCurrency":"TWD","commentFees":0,"commentID":"d6dfc539-68a4-d2af-39ea-01528e268936","commentLastAltered":1454083836,"commentType":"备忘"}},"tripContent":"","tripID":"1f7b81f6-f73e-1899-2895-01528c2af86f","tripLastAltered":1454058706,"tripMinutes":60,"tripSort":3,"tripSubject":"高妈妈民宿, 自在客","tripType":"住宿"},"fc6a2936-3e29-77e5-5257-01528c2c6727":{"tripComments":[],"tripContent":"","tripID":"fc6a2936-3e29-77e5-5257-01528c2c6727","tripLastAltered":1454050666,"tripMinutes":120,"tripSort":4,"tripSubject":"九份老街","tripType":"观光"},"fa5c7032-7187-f34c-b99e-01528c2d07b6":{"tripComments":{"f318a89e-75c1-4e39-7dc5-01528c2d65a7":{"commentContent":"856、825、788、1062","commentCurrency":"TWD","commentFees":0,"commentID":"f318a89e-75c1-4e39-7dc5-01528c2d65a7","commentLastAltered":1454050731,"commentType":"攻略"}},"tripContent":"","tripID":"fa5c7032-7187-f34c-b99e-01528c2d07b6","tripLastAltered":1454050707,"tripMinutes":15,"tripSort":5,"tripSubject":"九份老街站 - 黄金博物馆站, 公车","tripType":"交通"},"2ba4662b-be1d-cea5-0e80-01528c2d9e1f":{"tripComments":[],"tripContent":"","tripID":"2ba4662b-be1d-cea5-0e80-01528c2d9e1f","tripLastAltered":1454050746,"tripMinutes":120,"tripSort":6,"tripSubject":"黄金博物馆站","tripType":"观光"}}},"d8d6c79e-1681-2223-5139-01527ea1d372":{"dayID":"d8d6c79e-1681-2223-5139-01527ea1d372","dayLastAltered":1454055351,"dayTimestamp":1455667200,"dayTrips":{"af119e1f-91e5-ff90-ae72-