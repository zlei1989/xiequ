{"56a1a634-a21b-e06d-9df3-01527dc2353c":{"dayID":"56a1a634-a21b-e06d-9df3-01527dc2353c","dayLastAltered":1454926651,"dayTimestamp":1454900400,"dayTrips":{"92fae553-3f7b-ce1d-50a0-01527dc36ddb":{"tripComments":{"95d33ae5-fc68-d8d9-40d1-0152870773ee":{"commentContent":"479-9614208918, ZHANG\/LEI\n479-9614208919, ZHAO\/MINGYING","commentCurrency":"CNY","commentFees":0,"commentID":"95d33ae5-fc68-d8d9-40d1-0152870773ee","commentLastAltered":1454082732,"commentType":"票证"},"535ab4f4-8a46-fb87-ece1-0152c0c412ae":{"commentContent":"我的家庭并不是特别富裕的那种，但是我一项坚持多去一些地方，尝试一些新鲜，给自己的生活也加些挑战。来台湾的理由有三点，首先是北平无战事的电视剧让我建立了民国时期中国优秀人才的想象；几月前看过一个短篇小说的情侣蜜月地；时间和经济都很合适。\n\n我和莹旅行过几次，每次旅行我都对她有新的敬佩，南京那次印象最深的就是她能把自己的事整理的很好，每天早上，我起床时她就基本快化妆结束了，热水也晾在桌上，我完全不用插入她的时间。这次更是如此，整个行程都是她一人安排，我只把很少的钱打给她就享受这么美好的一些日子。反过来她容入我的时间变得越来越多。因为遇见她，生活轻松许多。","commentCurrency":"CNY","commentFees":0,"commentID":"535ab4f4-8a46-fb87-ece1-0152c0c412ae","commentLastAltered":1455064745,"commentType":"游记"}},"tripContent":"北京, CA189, 14:00-17:30","tripID":"92fae553-3f7b-ce1d-50a0-01527dc36ddb","tripLastAltered":1454926918,"tripMinutes":210,"tripSort":1,"tripSubject":"北京首都机场T3, CA189","tripType":"交通"},"5e3c769a-ec03-6d85-9aa9-01527e818e18":{"tripComments":[],"tripContent":"","tripID":"5e3c769a-ec03-6d85-9aa9-01527e818e18","tripLastAltered":1454926918,"tripMinutes":180,"tripSort":0,"tripSubject":"家","tripType":"交通"},"0fca16ec-1e87-308d-7d69-015286fda768":{"tripComments":{"e608aba8-0fef-6b34-c68b-01528c151886":{"commentContent":"悠游卡、青壮卡、电话卡","commentCurrency":"TWD","commentFees":0,"commentID":"e608aba8-0fef-6b34-c68b-01528c151886","commentLastAltered":1454049139,"commentType":"备忘"},"360da604-f4a3-5991-c186-0152c069e622":{"commentContent":"15日电话卡","commentCurrency":"TWD","commentFees":770,"commentID":"360da604-f4a3-5991-c186-0152c069e622","commentLastAltered":1454927625,"commentType":"记账"},"84c9c2f5-f06f-ae3b-2ee7-0152c06aa715":{"commentContent":"悠游卡","commentCurrency":"TWD","commentFees":1000,"commentID":"84c9c2f5-f06f-ae3b-2ee7-0152c06aa715","commentLastAltered":1454927161,"commentType":"记账"}},"tripContent":"","tripID":"0fca16ec-1e87-308d-7d69-015286fda768","tripLastAltered":1454926918,"tripMinutes":60,"tripSort":2,"tripSubject":"台湾桃园机场T2","tripType":"购物"},"f502848d-9786-6aaf-306f-01528700b96a":{"tripComments":{"9e3509ea-4c99-169f-c1e4-0152870458e6":{"commentContent":"统联客运1623路(14:55...30m+2时)；","commentCurrency":"TWD","commentFees":480,"commentID":"9e3509ea-4c99-169f-c1e4-0152870458e6","commentLastAltered":1454929442,"commentType":"票证"},"35ec7beb-728c-2ab3-7165-01528bcedb95":{"commentContent":"第一航厦：入境B1层巴士乘车处；\n第二航厦：一楼入境大厅北侧外方廊。","commentCurrency":"CNY","commentFees":0,"commentID":"35ec7beb-728c-2ab3-7165-01528bcedb95","commentLastAltered":1454083278,"commentType":"攻略"},"ec34cb25-2fee-1bc8-65e3-0152c0c0f2b4":{"commentContent":"进入台湾从机场开始，扑面的霉味，我感冒的鼻子都能闻的清晰。近两年感觉中国正在直线向前发展，机场的服务给我感觉就很亲切，所以来到台湾，感觉没有变化，就好像是另一个北京，大家非常亲切，有意思的是，大陆人喜欢写牌子，看墙面。台湾人喜欢小册子，莹在机场咨询的时候，她看着服务员，服务员看这她，但是余光中翻阅着A4大小的档案夹，还边讲边指，真过仔细。购买后也是，票面重点信息都指给我们。\n\n买完票，我们坐上巴士前往台中，司机看上年龄50上下，服务热情，硕大的行李帮我们塞进车，我想上前帮忙都没让管，长途车2个多小时，车上有厕所，中途不停歇，过去的几个小时真是助燃了我对台湾的热情，四个月的筹备，现在，我俩的旅程就在脚下！","commentCurrency":"CNY","commentFees":0,"commentID":"ec34cb25-2fee-1bc8-65e3-0152c0c0f2b4","commentLastAltered":1454932817,"commentType":"游记"}},"tripContent":"","tripID":"f502848d-9786-6aaf-306f-01528700b96a","tripLastAltered":1454926918,"tripMinutes":160,"tripSort":3,"tripSubject":"台湾桃园机场 - 台中火车站, 公车","tripType":"交通"},"4cbf86ed-8507-2f58-92bb-0152870d1222":{"tripComments":{"6087465a-f925-6b12-f14f-01528bcfe8ad":{"commentContent":"地址：台中市东区复兴路四段100号(后火车站对面)\n电话：+886-422235838","commentCurrency":"CNY","commentFees":535,"commentID":"6087465a-f925-6b12-f14f-01528bcfe8ad","commentLastAltered":1454083390,"commentType":"票证"},"2c725320-7a1f-762c-c86e-01528e1ecaba":{"commentContent":"開車：下交流道直走中港路→中正路到火車站，右轉至台中路，台中路左轉復興路。\n\n搭車：搭客運到朝馬站下車，再搭乘台中客運27、103、146、147到台中火車站(前站)下車，再步行走地下道至火車後站，出後站右轉再步行三分鐘即可抵達。","commentCurrency":"CNY","commentFees":0,"commentID":"2c725320-7a1f-762c-c86e-01