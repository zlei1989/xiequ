# ─── 数据库 ──────────────────────────────────────────
# SQLite 数据库文件路径（默认 ./data/app.db）
DB_PATH=./data/app.db

# ─── 腾讯云 COS 对象存储（旅行模块图片/数据存储） ────
# 以下四个变量必须全部设置或全部留空
OSS_ENDPOINT=ap-beijing        # COS 地域端点（如 ap-beijing）
OSS_SECRET_ID=                 # COS SecretId
OSS_SECRET_KEY=                # COS SecretKey
OSS_BUCKET=                    # COS 存储桶名称
# 旅行模块 OSS 存储路径
OSS_TRAVEL_LOCATIONS_KEY=apps/travel/locations.json   # 地点数据文件路径
OSS_TRAVEL_POSTERS_PREFIX=apps/travel/posters         # 旅行图片存储前缀

# ─── 高德地图（旅行模块定位/搜索） ──────────────────
NEXT_PUBLIC_AMAP_KEY=          # 高德地图 JS API Key（前端使用）
NEXT_PUBLIC_AMAP_SECRET=       # 高德地图 JS API Secret（前端使用）

# ─── 浇花 IoT 设备配置 ──────────────────────────────
WATERING_POLL_INTERVAL=15000       # 设备轮询间隔（毫秒），默认 15 秒
WATERING_SLEEP_DURATION=300000     # 空闲深度睡眠时长（毫秒），默认 5 分钟

# ─── 部署：腾讯云 COS 上传 ─────────────────────────────
DEPLOY_COS_BUCKET=             # COS 存储桶名称
DEPLOY_COS_REGION=             # COS 地域
DEPLOY_COS_SECRET_ID=          # COS SecretId
DEPLOY_COS_SECRET_KEY=         # COS SecretKey

# ─── 部署：腾讯云 SCF 云函数 ───────────────────────────
DEPLOY_SCF_REGION=             # SCF 地域
DEPLOY_SCF_SECRET_ID=          # SCF SecretId
DEPLOY_SCF_SECRET_KEY=         # SCF SecretKey
DEPLOY_SCF_FUNCTION=           # SCF 函数名
