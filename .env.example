# ─── 数据库 ──────────────────────────────────────────
# SQLite 数据库文件路径（默认 ./data/app.db）
DB_PATH=./data/app.db

# ─── 腾讯云 COS 对象存储（旅行模块图片/数据存储） ────
# 四个变量必须全部设置或全部留空
OSS_ENDPOINT=ap-beijing
OSS_SECRET_ID=
OSS_SECRET_KEY=
OSS_BUCKET=
# 旅行模块 OSS 路径
OSS_TRAVEL_LOCATIONS_KEY=apps/travel/locations.json
OSS_TRAVEL_POSTERS_PREFIX=apps/travel/posters

# ─── 高德地图（旅行模块定位/搜索） ──────────────────
NEXT_PUBLIC_AMAP_KEY=

# ─── 浇花 IoT 设备配置 ──────────────────────────────
WATERING_POLL_INTERVAL=15000       # 设备轮询间隔（毫秒），默认 15 秒
WATERING_SLEEP_DURATION=300000     # 空闲深度睡眠时长（毫秒），默认 5 分钟

# ─── 部署：腾讯云 COS 上传 ─────────────────────────────
DEPLOY_COS_BUCKET=
DEPLOY_COS_REGION=
DEPLOY_COS_SECRET_ID=
DEPLOY_COS_SECRET_KEY=

# ─── 部署：腾讯云 SCF 云函数 ───────────────────────────
DEPLOY_SCF_REGION=
DEPLOY_SCF_SECRET_ID=
DEPLOY_SCF_SECRET_KEY=
DEPLOY_SCF_FUNCTION=
