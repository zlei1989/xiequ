# ─── 数据库 ──────────────────────────────────────────
# SQLite 数据库文件路径（默认 ./data/app.db）
DB_PATH=./data/app.db

# ─── 腾讯云 COS 对象存储（旅行模块图片/数据存储） ────
# 四个变量必须全部设置或全部留空
OSS_ENDPOINT=ap-beijing
OSS_SECRET_ID=
OSS_SECRET_KEY=
OSS_BUCKET=
# 旅行模块 OSS 路径
OSS_TRAVEL_LOCATIONS_KEY=apps/travel/locations.json
OSS_TRAVEL_POSTERS_PREFIX=apps/travel/posters

# ─── 高德地图（旅行模块定位/搜索） ──────────────────
NEXT_PUBLIC_AMAP_KEY=
